APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_PATH=./data/paper_agent.sqlite3
STORAGE_ROOT=./data/storage

# DeepSeek is OpenAI-compatible for chat completions.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-with-your-key
LLM_MODEL=deepseek-chat
LLM_INTERFACE=chat_completions
LLM_MAX_CONTEXT_CHARS=14000
# LLM request timeout (seconds)
LLM_REQUEST_TIMEOUT_SECONDS=120
# LLM cost estimation (USD per 1K tokens, for observability only)
LLM_PROMPT_COST_USD_PER_1K=0.0
LLM_COMPLETION_COST_USD_PER_1K=0.0

# --- Chat Runtime Control ---
# Overall workflow timeout (seconds)
CHAT_WORKFLOW_TIMEOUT_SECONDS=180
# Per-agent timeout (seconds)
CHAT_AGENT_TIMEOUT_SECONDS=75
# Per-tool-call timeout (seconds)
CHAT_TOOL_TIMEOUT_SECONDS=30
# LLM call retry attempts
CHAT_LLM_RETRY_ATTEMPTS=2
# LLM retry backoff base (seconds)
CHAT_LLM_RETRY_BACKOFF_SECONDS=1.5
# Max parallel agents in a batch
CHAT_PARALLEL_AGENT_LIMIT=3
# Max tool-calling turns per agent
CHAT_AGENT_MAX_TOOL_TURNS=3
# Max total tool calls per agent
CHAT_MAX_TOOL_CALLS_PER_AGENT=8
# Daily token budget per user (tokens)
CHAT_DAILY_USER_TOKEN_BUDGET=250000
# Daily tool call budget per user
CHAT_DAILY_USER_TOOL_BUDGET=200
# Estimated characters per token (for budget estimation)
CHAT_ESTIMATED_CHARS_PER_TOKEN=3.6
# Enable shell execution tool (DANGEROUS - only for local dev)
CHAT_SHELL_TOOL_ENABLED=false

BRAVE_API_KEY=

# Put your PaddleOCR token here. Do not commit a real token.
PADDLEOCR_TOKEN=
PADDLEOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.5
PADDLEOCR_DAILY_PAGE_LIMIT=20000
PADDLEOCR_CHUNK_PAGES=10

DEFAULT_ARXIV_CATEGORIES=cs.AI,cs.CL,cs.CV,cs.GR,cs.LG,stat.ML
CRAWL_INTERVAL_MINUTES=720

# --- RAG / Chunking ---
RAG_CHROMA_PATH=./data/chroma
RAG_COLLECTION_NAME=daily_paper_chunks
RAG_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
RAG_EMBEDDING_MAX_LENGTH=2048
CHUNK_HEADER_LEVELS=#,##,###
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=75

# --- Daily Paper ---
DAILY_PAPER_DEFAULT_MAX_RESULTS=12
DAILY_PAPER_SUMMARY_CHARS=18000
